{
  "name": "hydro-grid",
  "version": "1.0.0",
  "private": true,
  "description": "Smart hydroponic management system (MERN + IoT telemetry)",
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "simulate": "npm run simulate --prefix backend",
    "create-platform-admin": "npm run create-platform-admin --prefix backend",
    "build": "npm run build --prefix frontend",
    "lint": "npm run lint --prefix frontend"
  }
}
