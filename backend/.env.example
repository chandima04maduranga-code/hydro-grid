# Copy this file to `.env` and fill in real values.
# Never commit the real `.env` file.

PORT=5000

# MongoDB Atlas connection string (Atlas → Connect → Drivers)
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/Hydro_Grid?retryWrites=true&w=majority

# Long random string used to sign login tokens
JWT_SECRET=replace-with-a-long-random-string

# Frontend address allowed to call this API (CORS)
CLIENT_URL=http://localhost:5173

# PayHere payments (https://sandbox.payhere.lk → Settings → Domains & Credentials).
# Leave empty to turn online payments off.
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
# true = sandbox (test cards, no real money), false = live
PAYHERE_SANDBOX=true
# Public address of this API, used for PayHere's payment notification.
# PayHere cannot reach localhost, so for local tests use a tunnel (e.g. ngrok).
API_PUBLIC_URL=http://localhost:5000

# Optional: password for every demo account created by `npm run setup-demo`
# (if unset, the script asks for it). Demo data only — never a real password.
# DEMO_PASSWORD=

# Optional: DNS servers for the MongoDB SRV lookup. Set this if startup fails
# with "querySrv ECONNREFUSED" (Node.js cannot use the system DNS resolver).
# DNS_SERVERS=8.8.8.8,1.1.1.1
